DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_om?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
PLATFORM_ADMIN_EMAIL="admin@example.com"
PLATFORM_ADMIN_PASSWORD=""
PLATFORM_ADMIN_NAME="Platform Administrator"

# S3-compatible public storage for tenant and platform logos.
S3_REGION="auto"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="true"

# Resend delivery adapter. Use a sender address verified by your Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@example.com"
