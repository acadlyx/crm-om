generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  STAFF
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  PLANNED
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.VarChar(160)
  email         String               @unique @db.VarChar(320)
  passwordHash  String               @map("password_hash")
  role          UserRole             @default(STAFF)
  tenantId      String?              @map("tenant_id") @db.Uuid
  tenant        Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notifications SystemNotification[]
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, role])
  @@map("users")
}

model Tenant {
  id        String            @id @default(uuid()) @db.Uuid
  slug      String            @unique @db.VarChar(80)
  users     User[]
  settings  BusinessSettings?
  customers Customer[]
  leads     Lead[]
  deals     Deal[]
  invoices  Invoice[]
  payments  Payment[]
  expenses  Expense[]
  tasks     Task[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

/// Global product identity. Default branding values live in lib/branding/defaults.ts.
model PlatformSettings {
  id             String   @id @default("global") @db.VarChar(32)
  productName    String   @map("product_name") @db.VarChar(120)
  productTagline String   @map("product_tagline") @db.VarChar(240)
  logoUrl        String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(2048)
  primaryColor   String   @map("primary_color") @db.VarChar(7)
  supportEmail   String?  @map("support_email") @db.VarChar(320)
  supportWebsite String?  @map("support_website") @db.VarChar(2048)
  footerText     String   @map("footer_text") @db.VarChar(500)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Independent tenant business identity used for invoices and tenant communications.
model BusinessSettings {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessName    String   @map("business_name") @db.VarChar(160)
  logoUrl         String?  @map("logo_url") @db.VarChar(2048)
  contactEmail    String?  @map("contact_email") @db.VarChar(320)
  contactPhone    String?  @map("contact_phone") @db.VarChar(40)
  address         String?  @db.VarChar(1000)
  invoicePrefix   String   @default("INV") @map("invoice_prefix") @db.VarChar(20)
  invoiceIdentity Json     @default("{}") @map("invoice_identity")
  preferences     Json     @default("{}")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("business_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(120)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Durable, recipient-scoped in-app notification.
model SystemNotification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String    @db.VarChar(200)
  body            String    @db.Text
  href            String?   @db.VarChar(2048)
  sourceLabel     String    @map("source_label") @db.VarChar(120)
  supportEmail    String?   @map("support_email") @db.VarChar(320)
  idempotencyKey  String?   @map("idempotency_key") @db.VarChar(200)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([recipientUserId, idempotencyKey])
  @@index([recipientUserId, readAt, createdAt])
  @@map("system_notifications")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(160)
  company   String?  @db.VarChar(160)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(40)
  status    String   @default("ACTIVE") @db.VarChar(20)
  notes     String?  @db.Text
  deals     Deal[]
  invoices  Invoice[]
  tasks     Task[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@map("customers")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName       String     @map("full_name") @db.VarChar(160)
  company        String?    @db.VarChar(160)
  email          String?    @db.VarChar(320)
  phone          String?    @db.VarChar(40)
  source         String?    @db.VarChar(80)
  status         LeadStatus @default(NEW)
  estimatedValue Decimal    @default(0) @map("estimated_value") @db.Decimal(12, 2)
  notes          String?    @db.Text
  deals          Deal[]
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, createdAt])
  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String    @db.VarChar(200)
  customerId        String?   @map("customer_id") @db.Uuid
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId            String?   @map("lead_id") @db.Uuid
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  value             Decimal   @default(0) @db.Decimal(12, 2)
  stage             DealStage @default(QUALIFICATION)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, stage, expectedCloseDate])
  @@index([tenantId, createdAt])
  @@map("deals")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String        @map("customer_id") @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceNumber String        @map("invoice_number") @db.VarChar(40)
  issueDate     DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?       @db.Text
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId, issueDate])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String        @map("invoice_id") @db.Uuid
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(OTHER)
  reference String?       @db.VarChar(160)
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, paidAt])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

model Expense {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String        @db.VarChar(200)
  category  String        @default("General") @db.VarChar(100)
  amount    Decimal       @db.Decimal(12, 2)
  spentAt   DateTime      @default(now()) @map("spent_at") @db.Date
  vendor    String?       @db.VarChar(160)
  method    PaymentMethod @default(OTHER)
  status    ExpenseStatus @default(PAID)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, spentAt])
  @@map("expenses")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, dueDate])
  @@map("tasks")
}
