generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  STAFF
  SALES
  DELIVERY
  COLLECTIONS
  INVENTORY_MANAGER
  ACCOUNTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum DealStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  PLANNED
  PAID
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DISPATCHED
  PARTIALLY_DELIVERED
  DELIVERED
  FAILED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE_ISSUE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  LOSS
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  name          String               @db.VarChar(160)
  email         String               @unique @db.VarChar(320)
  passwordHash  String               @map("password_hash")
  isActive      Boolean              @default(true) @map("is_active")
  role          UserRole             @default(STAFF)
  tenantId      String?              @map("tenant_id") @db.Uuid
  tenant        Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  notifications SystemNotification[]
  assignedDeliveries Delivery[] @relation("DeliveryAssignee")
  assignedFollowUps CustomerFollowUp[] @relation("FollowUpAssignee")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, role])
  @@map("users")
}

model Tenant {
  id        String            @id @default(uuid()) @db.Uuid
  slug      String            @unique @db.VarChar(80)
  users             User[]
  settings          BusinessSettings?
  customers         Customer[]
  leads             Lead[]
  deals             Deal[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  tasks             Task[]
  suppliers         Supplier[]
  products          Product[]
  inventoryMovements InventoryMovement[]
  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  deliveries        Delivery[]
  customerReceipts  CustomerReceipt[]
  supplierBills     SupplierBill[]
  supplierPayments  SupplierPayment[]
  ledgerEntries     LedgerEntry[]
  rolePermissions   RolePermission[]
  customerFollowUps CustomerFollowUp[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

/// Global product identity. Default branding values live in lib/branding/defaults.ts.
model PlatformSettings {
  id             String   @id @default("global") @db.VarChar(32)
  productName    String   @map("product_name") @db.VarChar(120)
  productTagline String   @map("product_tagline") @db.VarChar(240)
  logoUrl        String?  @map("logo_url") @db.VarChar(2048)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(2048)
  primaryColor   String   @map("primary_color") @db.VarChar(7)
  supportEmail   String?  @map("support_email") @db.VarChar(320)
  supportWebsite String?  @map("support_website") @db.VarChar(2048)
  footerText     String   @map("footer_text") @db.VarChar(500)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

/// Independent tenant business identity used for invoices and tenant communications.
model BusinessSettings {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessName    String   @map("business_name") @db.VarChar(160)
  logoUrl         String?  @map("logo_url") @db.VarChar(2048)
  contactEmail    String?  @map("contact_email") @db.VarChar(320)
  contactPhone    String?  @map("contact_phone") @db.VarChar(40)
  address         String?  @db.VarChar(1000)
  invoicePrefix   String   @default("INV") @map("invoice_prefix") @db.VarChar(20)
  invoiceIdentity Json     @default("{}") @map("invoice_identity")
  preferences     Json     @default("{}")
  currency        String   @default("INR") @db.VarChar(3)
  timezone        String   @default("Asia/Kolkata") @db.VarChar(80)
  financialYearStartMonth Int @default(4) @map("financial_year_start_month")
  inventoryCostingMethod String @default("WEIGHTED_AVERAGE") @map("inventory_costing_method") @db.VarChar(32)
  defaultPaymentTermsDays Int @default(0) @map("default_payment_terms_days")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("business_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(120)
  entityId    String?  @map("entity_id") @db.VarChar(120)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

/// Durable, recipient-scoped in-app notification.
model SystemNotification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  title           String    @db.VarChar(200)
  body            String    @db.Text
  href            String?   @db.VarChar(2048)
  sourceLabel     String    @map("source_label") @db.VarChar(120)
  supportEmail    String?   @map("support_email") @db.VarChar(320)
  idempotencyKey  String?   @map("idempotency_key") @db.VarChar(200)
  readAt          DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([recipientUserId, idempotencyKey])
  @@index([recipientUserId, readAt, createdAt])
  @@map("system_notifications")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(160)
  company   String?  @db.VarChar(160)
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(40)
  status    String   @default("ACTIVE") @db.VarChar(20)
  notes     String?  @db.Text
  addresses Json     @default("[]")
  creditLimit Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)
  paymentTermsDays Int @default(0) @map("payment_terms_days")
  deals     Deal[]
  invoices  Invoice[]
  tasks     Task[]
  orders    SalesOrder[]
  receipts  CustomerReceipt[]
  followUps CustomerFollowUp[]
  ledgerEntries LedgerEntry[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([tenantId, name])
  @@map("customers")
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName       String     @map("full_name") @db.VarChar(160)
  company        String?    @db.VarChar(160)
  email          String?    @db.VarChar(320)
  phone          String?    @db.VarChar(40)
  source         String?    @db.VarChar(80)
  status         LeadStatus @default(NEW)
  estimatedValue Decimal    @default(0) @map("estimated_value") @db.Decimal(12, 2)
  notes          String?    @db.Text
  deals          Deal[]
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, createdAt])
  @@map("leads")
}

model Deal {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String    @db.VarChar(200)
  customerId        String?   @map("customer_id") @db.Uuid
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId            String?   @map("lead_id") @db.Uuid
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  value             Decimal   @default(0) @db.Decimal(12, 2)
  stage             DealStage @default(QUALIFICATION)
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, stage, expectedCloseDate])
  @@index([tenantId, createdAt])
  @@map("deals")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String        @map("customer_id") @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceNumber String        @map("invoice_number") @db.VarChar(40)
  issueDate     DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  notes         String?       @db.Text
  salesOrderId  String?       @map("sales_order_id") @db.Uuid
  salesOrder    SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  receiptAllocations CustomerReceiptAllocation[]
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, salesOrderId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, customerId, issueDate])
  @@map("invoices")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String        @map("invoice_id") @db.Uuid
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(OTHER)
  reference String?       @db.VarChar(160)
  paidAt    DateTime      @default(now()) @map("paid_at") @db.Timestamptz(6)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, paidAt])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

model Expense {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String        @db.VarChar(200)
  category  String        @default("General") @db.VarChar(100)
  amount    Decimal       @db.Decimal(12, 2)
  spentAt   DateTime      @default(now()) @map("spent_at") @db.Date
  vendor    String?       @db.VarChar(160)
  method    PaymentMethod @default(OTHER)
  status    ExpenseStatus @default(PAID)
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, spentAt])
  @@map("expenses")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status, dueDate])
  @@map("tasks")
}


/// Supplier master data scoped to a single business workspace.
model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String   @db.VarChar(160)
  company          String?  @db.VarChar(160)
  email            String?  @db.VarChar(320)
  phone            String?  @db.VarChar(40)
  address          String?  @db.Text
  taxId            String?  @map("tax_id") @db.VarChar(80)
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  status           String   @default("ACTIVE") @db.VarChar(20)
  purchaseOrders   PurchaseOrder[]
  bills            SupplierBill[]
  payments         SupplierPayment[]
  ledgerEntries    LedgerEntry[]
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, name])
  @@index([tenantId, status])
  @@map("suppliers")
}

/// A product's stockOnHand is maintained transactionally with its inventory movements.
model Product {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku            String   @db.VarChar(80)
  name           String   @db.VarChar(200)
  category       String?  @db.VarChar(120)
  unit           String   @default("pcs") @db.VarChar(24)
  description    String?  @db.Text
  purchaseCost   Decimal  @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  stockOnHand    Decimal  @default(0) @map("stock_on_hand") @db.Decimal(14, 3)
  reorderLevel   Decimal  @default(0) @map("reorder_level") @db.Decimal(14, 3)
  status         String   @default("ACTIVE") @db.VarChar(20)
  orderItems     SalesOrderItem[]
  purchaseItems  PurchaseOrderItem[]
  receiptItems   GoodsReceiptItem[]
  deliveryItems  DeliveryItem[]
  movements      InventoryMovement[]
  invoiceItems   InvoiceItem[]
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, stockOnHand])
  @@map("products")
}

/// Append-only stock audit trail. Quantities are positive; movementType defines direction.
model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String                @map("product_id") @db.Uuid
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementType   InventoryMovementType @map("movement_type")
  quantity       Decimal               @db.Decimal(14, 3)
  unitCost       Decimal               @default(0) @map("unit_cost") @db.Decimal(12, 2)
  referenceType  String?               @map("reference_type") @db.VarChar(64)
  referenceId    String?               @map("reference_id") @db.Uuid
  idempotencyKey String?               @map("idempotency_key") @db.VarChar(160)
  notes          String?               @db.Text
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_movements")
}

/// Sales orders reserve intent; stock is deducted only when a delivery is posted.
model SalesOrder {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber        String           @map("order_number") @db.VarChar(48)
  customerId         String           @map("customer_id") @db.Uuid
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             SalesOrderStatus @default(DRAFT)
  orderDate          DateTime         @default(now()) @map("order_date") @db.Date
  expectedDeliveryAt DateTime?        @map("expected_delivery_at") @db.Timestamptz(6)
  subtotal           Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount          Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total              Decimal          @default(0) @db.Decimal(12, 2)
  notes              String?          @db.Text
  idempotencyKey     String?          @map("idempotency_key") @db.VarChar(160)
  items              SalesOrderItem[]
  deliveries         Delivery[]
  invoices           Invoice[]
  createdByUserId    String?          @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, customerId, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String     @id @default(uuid()) @db.Uuid
  orderId          String     @map("order_id") @db.Uuid
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryItems    DeliveryItem[]
  productId        String     @map("product_id") @db.Uuid
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  description      String?    @db.VarChar(240)
  quantity         Decimal    @db.Decimal(14, 3)
  deliveredQuantity Decimal   @default(0) @map("delivered_quantity") @db.Decimal(14, 3)
  unitPrice        Decimal    @map("unit_price") @db.Decimal(12, 2)
  unitCost         Decimal    @default(0) @map("unit_cost") @db.Decimal(12, 2)
  discountAmount   Decimal    @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal    @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal    @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_items")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id") @db.Uuid
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String   @db.VarChar(240)
  quantity    Decimal  @default(1) @db.Decimal(14, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber     String              @map("order_number") @db.VarChar(48)
  supplierId      String              @map("supplier_id") @db.Uuid
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime            @default(now()) @map("order_date") @db.Date
  expectedAt      DateTime?           @map("expected_at") @db.Date
  subtotal        Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal             @default(0) @db.Decimal(12, 2)
  notes           String?             @db.Text
  idempotencyKey  String?             @map("idempotency_key") @db.VarChar(160)
  items           PurchaseOrderItem[]
  receipts        GoodsReceipt[]
  bills           SupplierBill[]
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, orderDate])
  @@index([tenantId, supplierId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String        @map("product_id") @db.Uuid
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Decimal       @db.Decimal(14, 3)
  receivedQuantity Decimal       @default(0) @map("received_quantity") @db.Decimal(14, 3)
  receipts         GoodsReceiptItem[]
  unitCost         Decimal       @map("unit_cost") @db.Decimal(12, 2)
  lineTotal        Decimal       @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptNumber   String        @map("receipt_number") @db.VarChar(48)
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  status          ReceiptStatus @default(POSTED)
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  idempotencyKey  String?       @map("idempotency_key") @db.VarChar(160)
  notes           String?       @db.Text
  items           GoodsReceiptItem[]
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String           @id @default(uuid()) @db.Uuid
  receiptId           String           @map("receipt_id") @db.Uuid
  receipt             GoodsReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String           @map("purchase_order_item_id") @db.Uuid
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  productId           String           @map("product_id") @db.Uuid
  product             Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity            Decimal          @db.Decimal(14, 3)
  unitCost            Decimal          @map("unit_cost") @db.Decimal(12, 2)

  @@index([receiptId])
  @@index([productId])
  @@map("goods_receipt_items")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryNumber    String         @map("delivery_number") @db.VarChar(48)
  orderId           String         @map("order_id") @db.Uuid
  order             SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status            DeliveryStatus @default(PENDING)
  scheduledAt       DateTime?      @map("scheduled_at") @db.Timestamptz(6)
  dispatchedAt     DateTime?      @map("dispatched_at") @db.Timestamptz(6)
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz(6)
  assignedUserId    String?        @map("assigned_user_id") @db.Uuid
  assignedUser      User?          @relation("DeliveryAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  proofOfDelivery   String?        @map("proof_of_delivery") @db.VarChar(2048)
  failureReason     String?        @map("failure_reason") @db.Text
  idempotencyKey    String?        @map("idempotency_key") @db.VarChar(160)
  items             DeliveryItem[]
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, deliveryNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, assignedUserId, status])
  @@map("deliveries")
}

model DeliveryItem {
  id             String         @id @default(uuid()) @db.Uuid
  deliveryId     String         @map("delivery_id") @db.Uuid
  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderItemId    String         @map("order_item_id") @db.Uuid
  orderItem      SalesOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId      String         @map("product_id") @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Decimal        @db.Decimal(14, 3)
  unitCost       Decimal?       @map("unit_cost") @db.Decimal(12, 2)

  @@unique([deliveryId, orderItemId])
  @@index([productId])
  @@map("delivery_items")
}

model CustomerReceipt {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId      String          @map("customer_id") @db.Uuid
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receiptNumber   String          @map("receipt_number") @db.VarChar(48)
  amount          Decimal         @db.Decimal(12, 2)
  method          PaymentMethod   @default(OTHER)
  reference       String?         @db.VarChar(160)
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  status          ReceiptStatus   @default(POSTED)
  idempotencyKey  String?         @map("idempotency_key") @db.VarChar(160)
  notes           String?         @db.Text
  allocations     CustomerReceiptAllocation[]
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, receivedAt])
  @@map("customer_receipts")
}

model CustomerReceiptAllocation {
  id        String         @id @default(uuid()) @db.Uuid
  receiptId String         @map("receipt_id") @db.Uuid
  receipt   CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String         @map("invoice_id") @db.Uuid
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal        @db.Decimal(12, 2)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
  @@map("customer_receipt_allocations")
}

model SupplierBill {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId      String          @map("supplier_id") @db.Uuid
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?         @map("purchase_order_id") @db.Uuid
